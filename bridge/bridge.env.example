# Contoh konfigurasi bridge Muse Management Control.
# Salin file ini menjadi "bridge.env" di direktori bridge
# (default: ~/workspace/muse-bridge/bridge.env), lalu isi nilainya.
# File bridge.env asli JANGAN dibagikan atau dimasukkan ke repo:
# ia bisa berisi kunci pendaftaran dan kode pairing.
#
# Setiap variabel juga bisa diisi lewat config.json di direktori yang
# sama (nama field versi snake_case, misalnya "server_url").

# URL server Muse Management Control (WAJIB).
MUSE_SERVER_URL=https://musang.contoh-domain.lol

# Mode bridge: "real" untuk VM produksi, "demo" untuk simulasi lokal.
MUSE_BRIDGE_MODE=real

# Nama agent yang tampil di dashboard. Default: hostname mesin.
MUSE_AGENT_NAME=

# Nama worker — HARUS sama persis (case-sensitive) dengan nama worker
# di pool, kalau tidak pemeriksaan silang pool tidak akan menemukannya.
MUSE_WORKER_NAME=

# --- Pendaftaran (pilih salah satu; tidak perlu kalau identitas sudah
# --- tersimpan dari pendaftaran sebelumnya) ---

# Kunci pendaftaran mandiri (self-enrollment) dari dashboard:
# Pengaturan → kunci pendaftaran. Agant baru mendaftar sendiri dengan
# kunci ini lewat petunjuk di <MUSE_SERVER_URL>/agent.md.
MUSE_ENROLLMENT_KEY=

# ATAU kode pairing manual dari dashboard (menu pairing agent).
MUSE_PAIRING_CODE=

# --- Opsional: kontrol program di VM ---

# Nama unit systemd program yang dikelola dashboard (untuk perintah
# jalankan / hentikan / mulai ulang / pulihkan). Kosongkan bila
# dashboard hanya memantau tanpa mengendalikan program.
MUSE_MINER_UNIT=

# URL endpoint statistik lokal program di VM ini (HTTP, di mesin yang
# sama), contoh: http://127.0.0.1:8080/stats — bila diisi, bridge
# membaca hashrate, share diterima/ditolak, tinggi job, dan kesulitan
# dari endpoint itu dan melaporkannya ke dashboard. Kosongkan bila
# program tidak menyediakan endpoint statistik.
MUSE_MINER_STATS_URL=

# Path skrip reinstall di VM, dipakai perintah pulihkan bila unit
# program tidak ditemukan. Kosongkan bila tidak ada.
MUSE_REINSTALL_SCRIPT=

# Kemampuan yang dilaporkan bridge ke server, dipisah koma.
# Default bawaan bridge sudah cukup untuk pemakaian normal.
MUSE_CAPABILITIES=
