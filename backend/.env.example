# --- Database ---
# PostgreSQL connection string used by Prisma and the app.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/muse_control
# Test database (integration tests). Only needed for `npm test`.
DATABASE_URL_TEST=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/muse_control_test

# --- Auth ---
# Secret used to sign dashboard JWTs. Use a long random value in production.
JWT_SECRET=change-me-to-a-long-random-string
# Single administrator account, seeded on first boot if it does not exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Server ---
PORT=3001
HOST=127.0.0.1
# Public base URL of this server (e.g. https://control.example.com).
# Used to render the self-enrollment document served at GET /agent.md.
# Fallback when unset: http://127.0.0.1:<PORT> (fine for local dev only).
PUBLIC_BASE_URL=
# CORS origin for the dashboard in dev (e.g. http://localhost:3000). Empty = allow all (dev only).
CORS_ORIGIN=

# --- Pool provider (Phase 1 ships a disabled placeholder only) ---
POOL_PROVIDER=none
POOL_API_BASE_URL=
POOL_API_KEY=
POOL_LOOKUP_PARAM=
